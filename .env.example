PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

MONGODB_URI=
DB_NAME=pizzahub

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Optional: lifetime of the access JWT (default 15m)
JWT_EXPIRES_IN=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only used by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImgBB image hosting, used by POST /api/vendor/upload-image.
# Get a free key at https://api.imgbb.com/ (log in to imgbb.com, open "Get API key").
# Keep it secret, never commit it. If empty, the upload endpoint answers 503.
IMGBB_API_KEY=

# Optional: extra browser origins allowed to call this API (comma separated, exact http(s) origins, no "*").
# CLIENT_URL is always allowed. Example for local frontend development against a deployed API:

# Stripe: vendor Premium subscription (POST /api/vendor/subscription/checkout and POST /api/stripe/webhook).
# All three are REQUIRED when NODE_ENV=production (the server refuses to start without them);
# in development they are optional and the payment endpoints answer 503 until they are set.
# Never commit real values. Use test-mode values (sk_test_..., price_...) until you go live.
#   STRIPE_SECRET_KEY        Stripe Dashboard > Developers > API keys > Secret key (sk_test_... / sk_live_...)
#   STRIPE_WEBHOOK_SECRET    the signing secret (whsec_...) of the webhook endpoint, or the one `stripe listen` prints
#   STRIPE_PREMIUM_PRICE_ID  Stripe Dashboard > Product catalogue > your Premium product > its recurring Price (price_...).
#                            The amount, currency and billing period come from this Price, never from the app or a client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
