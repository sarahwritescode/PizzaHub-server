PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

MONGODB_URI=
DB_NAME=pizzahub

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Optional: lifetime of the access JWT (default 15m)
JWT_EXPIRES_IN=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only used by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImgBB image hosting, used by POST /api/vendor/upload-image.
# Get a free key at https://api.imgbb.com/ (log in to imgbb.com, open "Get API key").
# Keep it secret, never commit it. If empty, the upload endpoint answers 503.
IMGBB_API_KEY=

# Optional: extra browser origins allowed to call this API (comma separated, exact http(s) origins, no "*").
# CLIENT_URL is always allowed. Example for local frontend development against a deployed API:
