    {
      "name": "4. Valid credentials and roles",
      "item": [
        {
          "name": "T3 Valid JWT (customer) /protected -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const u = pm.response.json().user;",
                  "pm.test(\"only id, email, role\", () => pm.expect(Object.keys(u).sort()).to.eql([\"email\",\"id\",\"role\"]));",
                  "pm.test(\"role is customer\", () => pm.expect(u.role).to.eql(\"customer\"));"
                ]
              }
            }
