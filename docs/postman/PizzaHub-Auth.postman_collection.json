          "name": "T4 Expired token -> 401 TOKEN_EXPIRED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is TOKEN_EXPIRED\", () => pm.expect(pm.response.json().code).to.eql(\"TOKEN_EXPIRED\"));"
                ]
              }
            }
          ],
          "request": {
