{
  "info": {
    "name": "PizzaHub - Auth (JWT) tests",
    "description": "See docs/AUTH_TESTING.md. Run folders in order. The first folder must run BEFORE you sign in, because Postman sends the session cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "clientUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": "Passw0rdOK"
    },
    {
      "key": "customerEmail",
      "value": "customer@pizzahub.test"
    },
    {
      "key": "vendorEmail",
      "value": "vendor@pizzahub.test"
    },
    {
      "key": "blockedEmail",
      "value": "blocked@pizzahub.test"
    },
    {
      "key": "adminEmail",
      "value": "REPLACE_WITH_ADMIN_EMAIL_USED_IN_seed_admin"
    },
    {
      "key": "adminPassword",
      "value": "REPLACE_WITH_ADMIN_PASSWORD_USED_IN_seed_admin"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "vendorToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "blockedToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. No / invalid credentials (run first, with an empty cookie jar)",
      "item": [
        {
          "name": "T1 No credentials -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is NO_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"NO_CREDENTIALS\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/test/protected"
          }
        },
        {
          "name": "T2 Invalid token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is INVALID_TOKEN\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_TOKEN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.valid.jwt"
              }
            ],
            "url": "{{baseUrl}}/api/test/protected"
          }
        }
      ]
    },
    {
      "name": "2. Setup (once)",
      "item": [
        {
          "name": "Sign up customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"signed up (200) or already exists\", () => pm.expect(pm.response.code).to.be.oneOf([200, 422]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/sign-up/email"
          }
        },
        {
          "name": "Sign up vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"signed up (200) or already exists\", () => pm.expect(pm.response.code).to.be.oneOf([200, 422]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"vendor\",\n  \"email\": \"{{vendorEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"vendor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/sign-up/email"
          }
        },
        {
          "name": "Sign up blocked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"signed up (200) or already exists\", () => pm.expect(pm.response.code).to.be.oneOf([200, 422]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"blocked\",\n  \"email\": \"{{blockedEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/sign-up/email"
          }
        }
      ]
    },
    {
      "name": "3. Sign in and collect JWTs",
      "item": [
        {
          "name": "Sign in customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/sign-in/email"
          }
        },
        {
          "name": "Get JWT (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"response has a JWT\", () => pm.expect(token.split(\".\")).to.have.length(3));",
                  "pm.collectionVariables.set(\"customerToken\", token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/token",
            "description": "Uses the session cookie that the sign-in request above stored in Postman's cookie jar."
          }
        },
