            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/test/protected",
            "description": "Run this AFTER the token lifetime has passed (default 15 min). For a quick test set JWT_EXPIRES_IN=10s in .env, restart, run folder 2, wait 15 seconds, run this request."
          }
        }
      ]
    },
