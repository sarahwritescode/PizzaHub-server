    {
      "name": "4. Valid uploads (needs a REAL IMGBB_API_KEY on the server)",
      "item": [
        {
          "name": "T1/T11 Vendor uploads a JPEG -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"success is true\", () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test(\"1 image(s) returned, each with an https url\", () => { const imgs = pm.response.json().data.images; pm.expect(imgs).to.have.lengthOf(1); imgs.forEach((i) => pm.expect(i.url).to.match(/^https:\\/\\//)); });",
                  "pm.test(\"no api key / delete_url in the response\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"delete_url\"); pm.expect(t).to.not.include(\"key=\"); });",
                  "const urls = pm.response.json().data.images.map((i) => i.url); pm.collectionVariables.set(\"uploadedUrl\", urls[0]); pm.collectionVariables.set(\"uploadedUrls\", JSON.stringify(urls));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
