{
  "info": {
    "name": "PizzaHub - Vendor image upload (ImgBB) tests",
    "description": "See docs/IMAGE_UPLOAD_TESTING.md. Run folder 1 FIRST with an empty cookie jar, then the other folders top to bottom. Every upload request has empty file slots: click 'Select Files' in Body > form-data and pick the file named in the request description. Successful upload cases need a REAL IMGBB_API_KEY in the server's .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "clientUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": "Passw0rdOK"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "vendorToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "uploadedUrl",
      "value": ""
    },
    {
      "key": "uploadedUrls",
      "value": ""
    },
    {
      "key": "menuItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. No login (run FIRST, with an empty cookie jar)",
      "item": [
        {
          "name": "T9 Upload without login -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is NO_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"NO_CREDENTIALS\"));",
                  "pm.test(\"success is false\", () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vendor/upload-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vendor",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "Select any .jpg file. Nothing may reach ImgBB."
          }
        }
      ]
    },
    {
      "name": "2. Setup (sign up / sign in the test users, save JWTs)",
      "item": [
        {
          "name": "Upload vendor: sign up (ok if the user already exists)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"signed up, or the user already exists\", () => pm.expect([200, 400, 409, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-up",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Upload vendor\",\n  \"email\": \"uploadvendor.{{runId}}@pizzahub.test\",\n  \"password\": \"{{password}}\",\n  \"role\": \"vendor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Upload vendor: sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{clientUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-in",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"uploadvendor.{{runId}}@pizzahub.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Upload vendor: get JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"token received\", () => { const t = pm.response.json().token; pm.expect(t).to.be.a(\"string\"); pm.collectionVariables.set(\"vendorToken\", t); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "description": "Uses the session cookie stored by the sign-in request right above it."
          }
        },
        {
          "name": "Upload customer: sign up (ok if the user already exists)",
          "event": [
            {
              "listen": "test",
